[Unit]
Description=SMSI Archive Client privileged updater
After=local-fs.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/libexec/smsi-archive-client-updater.py
Restart=on-failure
RestartSec=5
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/data/smsi-archive-client /data/smsi-archive-client-state /run
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
